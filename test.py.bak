import os
import pickle
import subprocess

# BUG 1: Hardcoded credentials (Security issue)
USERNAME = "admin"
PASSWORD = "admin123"

def load_user_data(file_path):
    # BUG 2: Insecure deserialization (pickle load)
    with open(file_path, "rb") as f:
        data = pickle.load(f)
    return data

def run_command(user_input):
    # BUG 3: Command Injection vulnerability
    command = "ping " + user_input
    os.system(command)

def divide_numbers(a, b):
    # BUG 4: No zero-division handling
    return a / b

def get_env_variable():
    # BUG 5: Environment variable may not exist
    return os.environ["SECRET_KEY"]

def execute_shell(cmd):
    # BUG 6: Dangerous subprocess usage with shell=True
    subprocess.call(cmd, shell=True)

def read_file(filename):
    # BUG 7: Path traversal vulnerability
    with open(filename, "r") as f:
        return f.read()

def main():
    print("User:", USERNAME)
    
    data = load_user_data("data.pkl")
    print(data)

    run_command("google.com; rm -rf /")

    result = divide_numbers(10, 0)
    print(result)

    secret = get_env_variable()
    print(secret)

    execute_shell("ls && whoami")

    content = read_file("../../etc/passwd")
    print(content)

if __name__ == "__main__":
    main()
